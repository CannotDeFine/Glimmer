# An explicit installed SDK only. No configure-time download or vendor copying.
function(glimmer_add_nccl_sdk root)
    if(NOT IS_ABSOLUTE "${root}" OR NOT EXISTS "${root}/include/nccl.h")
        message(FATAL_ERROR "GLIMMER_NCCL_ROOT must name an absolute installed NCCL SDK root")
    endif()
    file(REAL_PATH "${root}" _glimmer_nccl_root)
    if(TARGET Glimmer::nccl_headers)
        get_target_property(_glimmer_nccl_selected glimmer_nccl_headers GLIMMER_SDK_ROOT)
        if(NOT _glimmer_nccl_selected STREQUAL _glimmer_nccl_root)
            message(FATAL_ERROR "Only one NCCL SDK root may be selected in a build")
        endif()
        return()
    endif()
    foreach(_glimmer_nccl_part MAJOR MINOR PATCH)
        file(STRINGS "${root}/include/nccl.h" _glimmer_nccl_line
            REGEX "^#define[ \t]+NCCL_${_glimmer_nccl_part}[ \t]+[0-9]+")
        list(LENGTH _glimmer_nccl_line _glimmer_nccl_lines)
        if(NOT _glimmer_nccl_lines EQUAL 1)
            message(FATAL_ERROR "The installed NCCL SDK has an ambiguous version header")
        endif()
        if(NOT _glimmer_nccl_line MATCHES
                "^#define[ \t]+NCCL_${_glimmer_nccl_part}[ \t]+([0-9]+)([ \t]|$)")
            message(FATAL_ERROR "The installed NCCL SDK has an invalid version header")
        endif()
        set(_glimmer_nccl_${_glimmer_nccl_part} "${CMAKE_MATCH_1}")
    endforeach()
    set(_glimmer_nccl_version
        "${_glimmer_nccl_MAJOR}.${_glimmer_nccl_MINOR}.${_glimmer_nccl_PATCH}")
    if(NOT _glimmer_nccl_version VERSION_EQUAL "2.29.3")
        message(FATAL_ERROR "The developing native NCCL packets require audited SDK 2.29.3")
    endif()
    file(STRINGS "${root}/include/nccl.h" _glimmer_nccl_code
        REGEX "^#define[ \t]+NCCL_VERSION_CODE[ \t]+[0-9]+")
    list(LENGTH _glimmer_nccl_code _glimmer_nccl_code_lines)
    if(NOT _glimmer_nccl_code_lines EQUAL 1 OR
            NOT _glimmer_nccl_code MATCHES "^#define[ \t]+NCCL_VERSION_CODE[ \t]+22903([ \t]|$)")
        message(FATAL_ERROR "The installed NCCL SDK has an inconsistent version code")
    endif()
    set(_glimmer_nccl_library "_glimmer_nccl_library-NOTFOUND")
    unset(_glimmer_nccl_library CACHE)
    find_library(_glimmer_nccl_library NAMES nccl libnccl.so.2
        PATHS "${root}/lib" "${root}/lib64" NO_DEFAULT_PATH)
    if(NOT _glimmer_nccl_library)
        message(FATAL_ERROR "No installed NCCL library under GLIMMER_NCCL_ROOT")
    endif()
    add_library(glimmer_nccl_headers INTERFACE)
    add_library(Glimmer::nccl_headers ALIAS glimmer_nccl_headers)
    set_target_properties(glimmer_nccl_headers PROPERTIES GLIMMER_SDK_ROOT "${_glimmer_nccl_root}")
    target_include_directories(glimmer_nccl_headers SYSTEM INTERFACE "${root}/include")
    target_compile_definitions(glimmer_nccl_headers INTERFACE GLIMMER_HAS_NCCL=1)
    add_library(Glimmer::nccl SHARED IMPORTED GLOBAL)
    set_target_properties(Glimmer::nccl PROPERTIES IMPORTED_LOCATION "${_glimmer_nccl_library}"
        INTERFACE_LINK_LIBRARIES Glimmer::nccl_headers)
    unset(_glimmer_nccl_library CACHE)
endfunction()
