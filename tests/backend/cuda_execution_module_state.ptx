.version 7.4
.target sm_70
.address_size 64

.visible .global .align 4 .u32 invocations = 13;
.visible .const .align 4 .u32 bias = 7;

.visible .entry add_once(.param .u64 output, .param .u32 guard) {
    .reg .pred %p;
    .reg .b32 %r<11>;
    .reg .b64 %rd<4>;
    ld.param.u64 %rd1, [output];
    ld.param.u32 %r1, [guard];
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mov.u32 %r4, %tid.x;
    mad.lo.u32 %r5, %r2, %r3, %r4;
    add.u32 %r6, %r5, %r1;
    mul.wide.u32 %rd2, %r6, 4;
    add.u64 %rd3, %rd1, %rd2;
    ld.global.u32 %r7, [%rd3];
    mov.u32 %r8, %nctaid.x;
    ld.const.u32 %r9, [bias];
    add.u32 %r7, %r7, %r5;
    add.u32 %r7, %r7, %r8;
    add.u32 %r7, %r7, %r9;
    st.global.u32 [%rd3], %r7;
    setp.ne.u32 %p, %r5, 0;
    @%p bra DONE;
    ld.global.u32 %r10, [invocations];
    add.u32 %r10, %r10, 1;
    st.global.u32 [invocations], %r10;
DONE:
    ret;
}
