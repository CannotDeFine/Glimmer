if(NOT DEFINED APPLICATION OR NOT EXISTS "${APPLICATION}")
    message(FATAL_ERROR "Ordinary Runtime fixture is unavailable")
endif()
execute_process(COMMAND "${APPLICATION}" ${APPLICATION_ARGS}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 45)
message("${output}${diagnostic}")
if(NOT result STREQUAL "0" OR NOT output MATCHES "runtime_cooperative_transparency status=ok")
    message(FATAL_ERROR "Ordinary Runtime application failed: ${result}")
endif()
if(APPLICATION_ARGS MATCHES "^--graph")
    set(expected_handoff "cooperative_context grants=8 retreat=1 suspended=1 resumed=1 completed=7 failed=0")
    string(REGEX MATCHALL "cooperative_native_session grants=1 completed=1 failed=0 retained=0"
        source_executions "${diagnostic}")
    list(LENGTH source_executions source_execution_count)
    if(NOT source_execution_count EQUAL 2)
        message(FATAL_ERROR "Two source-session native executions lack exact physical terminal ownership")
    endif()
    string(REGEX MATCHALL "cooperative_native_session grants=0 completed=0 failed=0 retained=0"
        source_constructions "${diagnostic}")
    list(LENGTH source_constructions source_construction_count)
    if(source_construction_count LESS 2)
        message(FATAL_ERROR "Captured construction unexpectedly acquired execution grants")
    endif()
else()
    set(expected_handoff "cooperative_context grants=3 retreat=1 suspended=1 resumed=1 completed=2 failed=0")
endif()
string(REGEX MATCHALL "${expected_handoff}"
    handoffs "${diagnostic}")
list(LENGTH handoffs handoff_count)
if(NOT handoff_count EQUAL 2)
    message(FATAL_ERROR "Two native-reset-separated Runtime stop/resume rounds were not proven")
endif()
